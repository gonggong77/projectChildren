# KOPIS 요청 파라미터 service에 전달할 인증키
KOPIS_SERVICE_KEY=

# 행정안전부 놀이시설 API 요청 파라미터 serviceKey에 전달할 인증키
PLAYGROUND_SERVICE_KEY=

# 쉼표로 구분한 프론트엔드 허용 오리진 (비우면 로컬 Vite 주소 2개만 허용)
# 배포 시 Vercel 주소를 반드시 추가한다.
# 예: http://localhost:5173,http://127.0.0.1:5173,https://project-children-steel.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 배포/수동 동기화 API 보호용 시크릿 (POST /api/sync, GET /api/sync/status)
# 비우면 동기화 API는 503으로 비활성된다.
SYNC_SECRET=

# 서버 기동 시 자동 동기화: never | always | if_empty
# 배포 환경에서는 보통 if_empty (DB에 공연이 없을 때만 백그라운드 적재)
SYNC_ON_STARTUP=never
